    {
      "name": "Debug DeluluEngine",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreType": true
        }
      ]
    },
    {
  "name": "Launch DeluluEngine",
  "type": "cppdbg",
  "request": "launch",
  "program": "${command:cmake.launchTargetPath}",
  "cwd": "${workspaceFolder}",
  "MIMode": "gdb",
  "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
  "internalConsoleOptions": "neverOpen"
    }
    
    ]
